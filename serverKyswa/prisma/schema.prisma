model supplements {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom         String
  prix        Decimal   @db.Decimal(10, 2)
  description String?
  actif       Boolean   @default(true)
  created_by  String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  
  // Relations
  profiles          profiles?                    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  lignes_supplements lignes_supplements[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lignes_supplements {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantite     Int          @default(1)
  prix_unitaire Decimal     @db.Decimal(10, 2)
  prix_total   Decimal      @db.Decimal(10, 2)
  
  // Relations
  supplement_id String      @db.Uuid
  client_id     String?     @db.Uuid
  inscription_id String?    @db.Uuid
  created_by    String?     @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  
  supplements  supplements @relation(fields: [supplement_id], references: [id], onDelete: Cascade)
  clients      clients?    @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  inscriptions inscriptions? @relation(fields: [inscription_id], references: [id], onUpdate: NoAction)
  profiles     profiles?   @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@schema("public")
}

/// Tables pour le module Shop
model shop_produits {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                 String
  description         String?
  categorie           String // ALIMENTAIRE, EAU_ZAMZAM, DATTES, etc.
  prix                Decimal   @db.Decimal(10,2)
  prix_promo          Decimal?  @db.Decimal(10,2)
  stock               Int       @default(0)
  stock_min           Int       @default(5)
  statut              String    @default("ACTIF") // ACTIF, INACTIF, RUPTURE_STOCK, ARCHIVE
  marque              String?
  reference           String?   @unique
  code_barres         String?   @unique
  dimensions_json     Json?     // {longueur, largeur, hauteur, unite}
  poids               Float?
  images_json         Json?     // [{url, cloudinaryPublicId, altText, principal}]
  tags                String[]  @default([])
  fournisseur_json    Json?     // {nom, contact, telephone, email}
  notes               String?
  slug                String?
  meta_description    String?
  visible             Boolean   @default(true)
  cree_par_user_id    String?   @db.Uuid
  modifie_par_user_id String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  mouvements_stock    shop_stock_movements[]
  commande_items      shop_commande_items[]
  
  // Index
  @@index([nom, description])
  @@index([categorie, statut])
  @@index([reference])
  @@index([code_barres])
  @@schema("public")
}

model shop_stock_movements {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produit_id          String    @db.Uuid
  ancienne_quantite   Int
  nouvelle_quantite   Int
  quantite_ajustee    Int
  type                String    // AJOUT, RETRAIT, SET
  motif               String
  notes               String?
  reference_externe   String?
  document_source     String?
  cree_par_user_id    String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  produit             shop_produits @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  
  @@schema("public")
}

model shop_commandes {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String    @db.Uuid
  status              String    @default("EN_ATTENTE_PAIEMENT") // EN_ATTENTE_PAIEMENT, PAYEE, EXPEDIEE, LIVREE, ANNULEE
  montant_total       Decimal   @db.Decimal(10,2)
  notes               String?
  cree_par_user_id    String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  client              clients   @relation(fields: [client_id], references: [id])
  items               shop_commande_items[]
  
  @@schema("public")
}

model shop_commande_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commande_id String    @db.Uuid
  produit_id  String    @db.Uuid
  quantite    Int
  prix_unitaire Decimal @db.Decimal(10,2)
  prix_total  Decimal   @db.Decimal(10,2)
  
  // Relations
  commande    shop_commandes @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  produit     shop_produits  @relation(fields: [produit_id], references: [id])
  
  @@schema("public")
}
