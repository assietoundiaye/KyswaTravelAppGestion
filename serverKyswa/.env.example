# ============================================================
#  KYSWA TRAVEL — Variables d'environnement (EXEMPLE)
#  Copier ce fichier en .env et remplir les vraies valeurs
#  NE JAMAIS committer le .env reel dans Git
# ============================================================

# Serveur
PORT=3000
NODE_ENV=development

# JWT
# Generer avec : node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REMPLACER_PAR_UN_SECRET_64_OCTETS_ALEATOIRE
JWT_REFRESH_SECRET=REMPLACER_PAR_UN_SECRET_64_OCTETS_DIFFERENT
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=7d

# Base de donnees PostgreSQL
# Format local    : postgresql://USER@localhost:5432/NOM_DB?schema=public
# Format Supabase : postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=public
DATABASE_URL=postgresql://USER@localhost:5432/kyswa_local?schema=public

# Redis (optionnel en developpement)
DISABLE_REDIS=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Cloudinary (upload fichiers/photos)
# Obtenir sur https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=VOTRE_CLOUD_NAME
CLOUDINARY_API_KEY=VOTRE_API_KEY
CLOUDINARY_API_SECRET=VOTRE_API_SECRET

# Email Nodemailer (optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre@email.com
# SMTP_PASS=votre_mot_de_passe_app

# OCR Mindee (optionnel)
# MINDEE_API_KEY=VOTRE_CLE_MINDEE
